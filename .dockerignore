# Secondary boundary. The primary input is create_build_context.py's hash-checked
# explicit file list. Never build an unfiltered whole checkout for the pilot.
**
!app/
!app/**
!config/
!config/**
!tools/
!tools/pilot/
!tools/pilot/**
!g5/
!g5/**
!build/
!build/wheelhouse/
!build/wheelhouse/*.whl
!.dockerignore
**/__pycache__/
**/*.pyc
**/.git/
**/.env
**/.env.*
**/*.db
**/*.sqlite
**/*.sqlite3
**/*-wal
**/*-shm
**/*-journal
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.enc
**/identities.json
**/fixture-identities.json
**/fixture-app.key
**/fixture-old-cookie
**/evidence/
**/uploads/
